        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法修訂提交" } }
      }
    },
    "amendCancelledHeadChangedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "HEAD changed outside Colofa. Your Amend edits were discarded, and the message you had before entering Amend was restored." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Colofa の外部で HEAD が変更されました。修正中の編集内容は破棄され、修正を開始する前のメッセージが復元されました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Colofa 외부에서 HEAD가 변경되었습니다. 수정 중인 편집 내용은 삭제되었으며, 수정하기 전에 작성하던 메시지가 복원되었습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "HEAD 已在 Colofa 外部发生变化。修订期间的编辑已丢弃，并已恢复进入修订前的消息。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "HEAD 已在 Colofa 外部發生變更。修訂期間的編輯已捨棄，並已還原進入修訂前的訊息。" } }
      }
    },
