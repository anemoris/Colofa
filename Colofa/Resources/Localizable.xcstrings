    "pushDestination" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Destination" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "宛先" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目的地" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目的地" } }
      }
    },
    "pushDestinationLocalTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This Remote Is Not a Remote" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリモートはリモートではありません" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 원격은 원격이 아닙니다" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此远程并非远程" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此遠端並非遠端" } }
      }
    },
    "pushDestinationLocalDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” is Git's own name for this repository, so pushing to it would rewrite a local branch instead of sending this one anywhere. Colofa pushes to remotes only. Give this branch a real push remote in Git to continue." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」は Git がこのリポジトリ自身を指す名前です。そのためプッシュしても、どこかに送られるのではなくローカルブランチが書き換えられます。Colofa はリモートにのみプッシュします。続けるには、このブランチに実際のプッシュ先リモートを Git で設定してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@”은(는) Git이 이 저장소 자신을 가리키는 이름이므로, 푸시하면 어딘가로 보내는 대신 로컬 브랜치를 다시 씁니다. Colofa는 원격에만 푸시합니다. 계속하려면 Git에서 이 브랜치에 실제 푸시 원격을 설정하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“%@”是 Git 用来指代本仓库自身的名称，因此推送到它会改写一个本地分支，而不是把当前分支发送到任何地方。Colofa 只推送到远程。请先在 Git 中为该分支设置真正的推送远程。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」是 Git 用來指稱本儲存庫自身的名稱，因此推送到它會改寫一個本機分支，而不是把目前分支傳送到任何地方。Colofa 只推送到遠端。請先在 Git 中為該分支設定真正的推送遠端。" } }
      }
    },
    "pushDestinationSeveralTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This Remote Has Several Push Addresses" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリモートには複数のプッシュ先があります" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 원격에는 푸시 주소가 여러 개 있습니다" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此远程配置了多个推送地址" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此遠端設定了多個推送位址" } }
      }
    },
    "pushDestinationSeveralDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One push to “%1$@” writes to every address below in turn, so no single confirmation can say where it goes. A force push accepted at one address and refused at another cannot be rolled back as a whole. Leave one push address configured to continue.\n\n%2$@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%1$@」への 1 回のプッシュは以下のすべてのアドレスに順に書き込むため、どこへ送られるのかを 1 つの確認で示すことはできません。あるアドレスでは受け入れられ別のアドレスでは拒否された強制プッシュは、全体としては取り消せません。続けるには、プッシュ先を 1 つだけ設定してください。\n\n%2$@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%1$@”에 대한 한 번의 푸시는 아래의 모든 주소에 차례로 쓰므로, 한 번의 확인으로 어디로 가는지 말할 수 없습니다. 한 주소에서는 수락되고 다른 주소에서는 거부된 강제 푸시는 전체를 되돌릴 수 없습니다. 계속하려면 푸시 주소를 하나만 설정하세요.\n\n%2$@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对“%1$@”的一次推送会依次写入下面的每个地址，因此没有任何一次确认能说明它究竟写到了哪里。若强制推送在一个地址被接受、在另一个地址被拒绝，将无法整体回滚。请只保留一个推送地址后再继续。\n\n%2$@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "對「%1$@」的一次推送會依序寫入下面的每個位址，因此沒有任何一次確認能說明它究竟寫到了哪裡。若強制推送在一個位址被接受、在另一個位址被拒絕，將無法整體回復。請只保留一個推送位址後再繼續。\n\n%2$@" } }
      }
    },
    "pushDestinationChangedTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Push Destination Changed" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プッシュ先が変わりました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "푸시 대상이 변경되었습니다" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推送目的地已改变" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "推送目的地已改變" } }
      }
    },
    "pushDestinationChangedDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” no longer points at the address this Push was confirmed for, so nothing was sent. Open Push again to confirm the new destination." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」は、このプッシュを確認したときのアドレスをもう指していません。そのため何も送信されませんでした。新しい宛先を確認するには、もう一度プッシュを開いてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@”은(는) 이 푸시를 확인한 주소를 더 이상 가리키지 않으므로 아무것도 전송되지 않았습니다. 새 대상을 확인하려면 푸시를 다시 여세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“%@”已不再指向确认本次推送时的地址，因此什么也没有发送。请重新打开推送以确认新的目的地。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」已不再指向確認本次推送時的位址，因此什麼也沒有傳送。請重新開啟推送以確認新的目的地。" } }
      }
    },
