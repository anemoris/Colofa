    },
    "deleteBranchCancelledRefChangedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The branch changed after the confirmation opened, so nothing was deleted. Open Delete Branch again to see what it holds now." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "確認ダイアログを開いた後にブランチが変化したため、何も削除していません。もう一度「ブランチを削除」を開いて現在の内容を確認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "확인 대화상자를 연 뒤 브랜치가 변경되어 아무것도 삭제하지 않았습니다. ‘브랜치 삭제’를 다시 열어 현재 상태를 확인하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确认对话框打开后该分支发生了变化，因此未删除任何内容。请重新打开“删除分支”查看它当前持有的内容。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認對話框開啟後該分支發生了變化，因此未刪除任何內容。請重新開啟「刪除分支」查看它目前持有的內容。" } }
