        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發布分支失敗" } }
      }
    },
    "pushRejectedTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Push Rejected" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プッシュが拒否されました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "푸시 거부됨" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推送被拒绝" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "推送被拒絕" } }
      }
    },
    "pushRejectedDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%1$@” was not pushed, because “%2$@” contains work this branch does not have. Fetch, then Merge or Rebase, and push again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%2$@」にはこのブランチにない作業が含まれているため、「%1$@」はプッシュされませんでした。フェッチしてからマージまたはリベースし、もう一度プッシュしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%2$@”에 이 브랜치에 없는 작업이 있어 “%1$@”은(는) 푸시되지 않았습니다. 페치한 뒤 병합 또는 리베이스하고 다시 푸시하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“%2$@”包含此分支没有的工作，因此“%1$@”未被推送。请先获取，再合并或变基，然后重新推送。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%2$@」包含此分支沒有的工作，因此「%1$@」未被推送。請先擷取，再合併或重定基底，然後重新推送。" } }
      }
    },
    "pushLeaseRefusedTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Force Push Refused" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "強制プッシュが拒否されました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "강제 푸시 거부됨" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "强制推送被拒绝" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "強制推送被拒絕" } }
      }
    },
    "pushLeaseRefusedDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” has changed since this Push was confirmed, so the lease refused to overwrite it. Fetch and review the new work before force pushing again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このプッシュを確認してから「%@」が変化したため、リースが上書きを拒否しました。もう一度強制プッシュする前に、フェッチして新しい作業を確認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 푸시를 확인한 뒤 “%@”이(가) 변경되어 리스가 덮어쓰기를 거부했습니다. 다시 강제 푸시하기 전에 페치하여 새 작업을 확인하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自确认本次推送后“%@”已发生变化，租约拒绝覆盖它。请先获取并查看新的工作，再重新强制推送。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自確認本次推送後「%@」已發生變化，租約拒絕覆蓋它。請先擷取並查看新的工作，再重新強制推送。" } }
      }
    },
    "pushRemoteRefusedTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Remote Refused the Push" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートがプッシュを拒否しました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격이 푸시를 거부함" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "远程拒绝了推送" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "遠端拒絕了推送" } }
      }
    },
    "pushRemoteRefusedDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The remote declined to update “%@”. A hook or a branch protection rule usually explains it, and the remote's own answer is below." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートは「%@」の更新を拒否しました。通常はフックかブランチ保護の設定が理由で、リモート自身の応答は下に表示されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격이 “%@” 갱신을 거부했습니다. 대개 훅이나 브랜치 보호 규칙이 이유이며, 원격의 응답은 아래에 있습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "远程拒绝更新“%@”。通常是钩子或分支保护规则所致，远程自己的回应见下方。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "遠端拒絕更新「%@」。通常是掛鉤或分支保護規則所致，遠端自己的回應見下方。" } }
      }
    },
    "pushPublishingTo" : {
