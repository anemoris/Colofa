      }
    },
    "branchNameInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Git does not accept this branch name. Avoid spaces, “..”, “~”, “^”, “:”, “?”, “*”, “[”, and “\\”, and do not begin with “-” or end with “/” or “.lock”." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Git はこのブランチ名を受け付けません。スペースや「..」「~」「^」「:」「?」「*」「[」「\\」は使えず、「-」で始めることも「/」や「.lock」で終えることもできません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Git이 이 브랜치 이름을 허용하지 않습니다. 공백과 “..”, “~”, “^”, “:”, “?”, “*”, “[”, “\\”는 쓸 수 없고, “-”로 시작하거나 “/” 또는 “.lock”으로 끝날 수 없습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Git 不接受该分支名称。不能包含空格、“..”、“~”、“^”、“:”、“?”、“*”、“[”、“\\”，也不能以“-”开头或以“/”“.lock”结尾。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Git 不接受該分支名稱。不能包含空格、「..」、「~」、「^」、「:」、「?」、「*」、「[」、「\\」，也不能以「-」開頭或以「/」、「.lock」結尾。" } }
      }
    },
