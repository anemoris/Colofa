    "pullBlockedByLocalChanges" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These files have local changes the Pull would overwrite:\n\n%@\n\nCommit or Stash them first." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次のファイルには、プルによって上書きされるローカルの変更があります:\n\n%@\n\n先にコミットするかスタッシュしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 파일에는 풀이 덮어쓸 로컬 변경 사항이 있습니다:\n\n%@\n\n먼저 커밋하거나 스태시하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下文件的本地更改会被拉取覆盖：\n\n%@\n\n请先提交或贮藏这些更改。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下檔案的本機更改會被拉取覆蓋：\n\n%@\n\n請先提交或儲藏這些更改。" } }
      }
    },
    "pullBlockedByLocalWork" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This uncommitted work would be overwritten by the Pull:\n\n%@\n\nCommit or Stash the tracked changes, and move or remove the untracked files." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "コミットされていない次の作業は、プルによって上書きされます:\n\n%@\n\n追跡中の変更はコミットまたはスタッシュし、追跡されていないファイルは移動または削除してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "커밋되지 않은 다음 작업은 풀이 덮어씁니다:\n\n%@\n\n추적 중인 변경 사항은 커밋하거나 스태시하고, 추적되지 않는 파일은 옮기거나 삭제하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下尚未提交的工作会被拉取覆盖：\n\n%@\n\n请提交或贮藏已跟踪的更改，并移动或删除未跟踪的文件。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下尚未提交的工作會被拉取覆蓋：\n\n%@\n\n請提交或儲藏已追蹤的更改，並移動或刪除未追蹤的檔案。" } }
      }
    },
    "pullBlockedByUntrackedFiles" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These untracked files would be overwritten by the Pull:\n\n%@\n\nMove or remove them first." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次の追跡されていないファイルは、プルによって上書きされます:\n\n%@\n\n先に移動または削除してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 추적되지 않는 파일은 풀이 덮어씁니다:\n\n%@\n\n먼저 옮기거나 삭제하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下未跟踪的文件会被拉取覆盖：\n\n%@\n\n请先移动或删除它们。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下未追蹤的檔案會被拉取覆蓋：\n\n%@\n\n請先移動或刪除它們。" } }
      }
    },
