        "en" : { "stringUnit" : { "state" : "translated", "value" : "Resolve every Conflict before checking out another Ref." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "他の参照をチェックアウトする前に、すべてのコンフリクトを解決してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 참조를 체크아웃하기 전에 모든 충돌을 해결하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "签出其他引用前请先解决所有冲突。" } },
