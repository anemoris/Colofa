        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Git はブランチの削除を拒否しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Git이 브랜치 삭제를 거부했습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Git 拒绝删除该分支。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Git 拒絕刪除該分支。" } }
      }
    },
    "deleteBranchLosesCommits" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Commits held only by this branch: %@. Deleting it leaves them unreachable." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このブランチだけが保持しているコミット: %@。削除すると到達できなくなります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 브랜치만 가지고 있는 커밋: %@개. 삭제하면 도달할 수 없게 됩니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅由该分支持有的提交：%@ 个。删除后它们将无法到达。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅由該分支持有的提交：%@ 個。刪除後它們將無法到達。" } }
      }
    },
    "deleteBranchKeepsEveryCommit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Every Commit on this branch is also held by another Ref, so deleting it loses none." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このブランチのコミットはすべて他の参照も保持しているため、削除しても失われるコミットはありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 브랜치의 모든 커밋은 다른 참조도 가지고 있으므로 삭제해도 잃는 커밋이 없습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该分支上的每个提交都还有其他引用持有，删除它不会丢失任何提交。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "該分支上的每個提交都還有其他參照持有，刪除它不會遺失任何提交。" } }
      }
    },
    "deleteBranchHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete this local branch. Its remote branch and Remote-tracking Branch are left untouched." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このローカルブランチを削除します。リモートのブランチとリモート追跡ブランチはそのまま残ります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 로컬 브랜치를 삭제합니다. 원격 브랜치와 원격 추적 브랜치는 그대로 남습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除该本地分支。其远程分支与远程跟踪分支保持不变。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除該本機分支。其遠端分支與遠端追蹤分支保持不變。" } }
      }
    },
    "deleteBranchCheckFailedDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Colofa could not ask Git what removing this branch would cost, so nothing was deleted." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このブランチを削除した場合の影響を Git に問い合わせられなかったため、何も削除していません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 브랜치를 삭제할 때의 대가를 Git에 물어보지 못해 아무것도 삭제하지 않았습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Colofa 无法向 Git 询问删除该分支的代价，因此未删除任何内容。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Colofa 無法向 Git 詢問刪除該分支的代價，因此未刪除任何內容。" } }
      }
    },
    "deleteBranchCheckFailed" : {
