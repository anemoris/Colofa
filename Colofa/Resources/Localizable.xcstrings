      }
    },
    "forcePushWithLease" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Force Push with Lease" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リース付き強制プッシュ" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "리스를 사용한 강제 푸시" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "带租约的强制推送" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "帶租約的強制推送" } }
      }
    },
    "forcePushWithLeaseDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This replaces the history of “%@”. It is refused if the remote has moved since this dialog opened." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」の履歴を置き換えます。このダイアログを開いてからリモートが変化していた場合は拒否されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@”의 히스토리를 대체합니다. 이 대화상자를 연 뒤 원격이 변경되었다면 거부됩니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这会替换“%@”的历史。若自本对话框打开后远程已变动，推送将被拒绝。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這會取代「%@」的歷史。若自本對話框開啟後遠端已變動，推送將被拒絕。" } }
      }
    },
    "forcePushUnavailableNoLease" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Colofa has never seen this upstream, so there is no object to lease against. Fetch before force pushing." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この上流をまだ一度も取得していないため、リースの対象となるオブジェクトがありません。強制プッシュする前にフェッチしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 업스트림을 아직 한 번도 가져오지 않아 리스로 삼을 객체가 없습니다. 강제 푸시하기 전에 페치하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未获取过此上游，因此没有可作为租约的对象。请先获取再强制推送。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未擷取過此上游，因此沒有可作為租約的物件。請先擷取再強制推送。" } }
      }
    },
    "publishRemoteDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose the remote to create “%@” on. It becomes this branch's upstream." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」を作成するリモートを選択してください。そのリモートがこのブランチの上流になります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@”을(를) 만들 원격을 선택하세요. 해당 원격이 이 브랜치의 업스트림이 됩니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择用于创建“%@”的远程。该远程将成为此分支的上游。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇用於建立「%@」的遠端。該遠端將成為此分支的上游。" } }
      }
    },
