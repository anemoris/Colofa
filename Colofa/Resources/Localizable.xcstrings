    "discardChangesConfirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Only unstaged changes are restored to the staged version. Staged Changes are kept. This cannot be undone." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ステージされていない変更のみがステージ済みの内容に戻ります。ステージ済みの変更はそのまま残ります。この操作は取り消せません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스테이지되지 않은 변경 사항만 스테이지된 내용으로 되돌립니다. 스테이지된 변경 사항은 그대로 유지됩니다. 이 작업은 취소할 수 없습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有未暂存的更改会还原为已暂存的版本，已暂存的更改会保留。此操作无法撤销。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只有未暫存的更動會還原為已暫存的版本，已暫存的更動會保留。此操作無法還原。" } }
      }
    },
