        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 로컬 태그는 원격에서 다른 객체를 가리키므로 Git이 로컬 태그를 유지했습니다. 나머지 태그는 모두 다운로드되었습니다.\n\n%@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下本地标签在远程指向不同的对象，因此 Git 保留了本地版本。其余标签均已下载。\n\n%@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下本機標籤在遠端指向不同的物件，因此 Git 保留了本機版本。其餘標籤均已下載。\n\n%@" } }
      }
    },
