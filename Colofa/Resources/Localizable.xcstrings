      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This file is untracked, so Git has no copy to restore. Colofa moves it to the macOS Trash, where you can put it back." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このファイルは追跡されていないため、Git には復元できるコピーがありません。Colofa は macOS のゴミ箱に移動するので、あとで戻せます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 파일은 추적되지 않으므로 Git에 복원할 사본이 없습니다. Colofa는 파일을 macOS 휴지통으로 옮기며, 나중에 되돌릴 수 있습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该文件未被跟踪，Git 没有可还原的副本。Colofa 会将它移到 macOS 废纸篓，你可以从那里放回。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此檔案未被追蹤，Git 沒有可還原的副本。Colofa 會將它移到 macOS 垃圾桶，你可以從那裡放回。" } }
      }
