        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Colofa는 이 내용을 저장하지 않습니다. 기억할지 여부는 자격 증명 헬퍼, 키체인, ssh-agent가 결정합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Colofa 不会保存此内容。是否记住由你的凭据助手、钥匙串或 ssh-agent 决定。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Colofa 不會儲存此內容。是否記住由你的憑證輔助程式、鑰匙圈或 ssh-agent 決定。" } }
