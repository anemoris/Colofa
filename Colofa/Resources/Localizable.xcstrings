    "branchActionUnavailableOperationInProgress" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish or abort the Git operation in progress before checking out another Ref." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "他の参照をチェックアウトする前に、進行中の Git 操作を完了するか中止してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 참조를 체크아웃하기 전에 진행 중인 Git 작업을 완료하거나 중단하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "签出其他引用前请先完成或中止进行中的 Git 操作。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "簽出其他參照前請先完成或中止進行中的 Git 操作。" } }
