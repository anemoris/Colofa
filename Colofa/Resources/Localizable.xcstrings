    "cancelPush" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel Push" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プッシュをキャンセル" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "푸시 취소" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消推送" } },
