    "amendPublishedCommitMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This Commit already exists on a remote. Amending rewrites History, so publishing it again will require an explicit Force Push." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このコミットは既にリモートに存在します。修正すると履歴が書き換えられるため、再度公開するには明示的な強制プッシュが必要になります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 커밋은 이미 리모트에 있습니다. 수정하면 히스토리가 다시 쓰이므로, 다시 게시하려면 명시적인 강제 푸시가 필요합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该提交已存在于远程。修订会重写历史，因此再次发布时需要显式的强制推送。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此提交已存在於遠端。修訂會重寫歷史，因此再次發布時需要明確的強制推送。" } }
