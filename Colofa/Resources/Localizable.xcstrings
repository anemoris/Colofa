      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The current branch cannot be deleted. Check out another Ref first." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のブランチは削除できません。先に別の参照をチェックアウトしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 브랜치는 삭제할 수 없습니다. 먼저 다른 참조를 체크아웃하세요." } },
