    "pushCancelledRepositoryChangedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The repository changed while the dialog was open, so what it showed is no longer where this push would go. Nothing was sent. Start the push again to see the current destination." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ダイアログを開いている間にリポジトリが変化したため、表示されていた内容はこのプッシュの宛先ではなくなりました。何も送信されていません。現在の宛先を確認するには、もう一度プッシュを開始してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대화상자가 열려 있는 동안 저장소가 변경되어, 표시된 내용은 더 이상 이 푸시의 대상이 아닙니다. 아무것도 전송되지 않았습니다. 현재 대상을 확인하려면 푸시를 다시 시작하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对话框打开期间仓库发生了变化，其中显示的内容已不再是此次推送的去向。没有发送任何内容。请重新发起推送以查看当前目标。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "對話框開啟期間儲存庫發生變更，其中顯示的內容已不再是此次推送的去向。沒有傳送任何內容。請重新發起推送以查看目前目標。" } }
      }
    },
    "pushCancelledRepositoryChangedTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Push Canceled" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プッシュをキャンセルしました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "푸시가 취소됨" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已取消推送" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已取消推送" } }
      }
