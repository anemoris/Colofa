    "pullDivergedDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pull only fast-forwards, so nothing was changed. “%1$@” is %2$@ ahead of “%3$@” and %4$@ behind it. Use Merge or Rebase to integrate the two histories." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プルは早送りのみを行うため、何も変更されませんでした。「%1$@」は「%3$@」より %2$@ コミット先行し、%4$@ コミット遅れています。マージまたはリベースで両方の履歴を統合してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "풀은 빨리 감기만 하므로 아무것도 변경하지 않았습니다. “%1$@”은(는) “%3$@”보다 %2$@개 앞서고 %4$@개 뒤처져 있습니다. 병합 또는 리베이스로 두 히스토리를 통합하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拉取只做快进，因此未做任何更改。“%1$@”领先“%3$@” %2$@ 个提交，落后 %4$@ 个提交。请使用合并或变基来整合两段历史。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "拉取只做快轉，因此未做任何更改。「%1$@」領先「%3$@」 %2$@ 個提交，落後 %4$@ 個提交。請使用合併或重定基底來整合兩段歷史。" } }
      }
    },
    "pullDivergedTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%1$@” and “%2$@” Have Diverged" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%1$@」と「%2$@」は分岐しています" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%1$@”과 “%2$@”이 갈라졌습니다" } },
