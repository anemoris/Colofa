    "branchNameCheckFailedDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Git could not be asked whether this name is acceptable." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この名前を使用できるかどうか Git に問い合わせられませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 이름을 사용할 수 있는지 Git에 확인하지 못했습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法向 Git 询问该名称是否可用。" } },
